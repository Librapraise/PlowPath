{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": false,
      "distribution": "internal",
      "ios": {
        "image": "latest"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "image": "latest"
      },
      "env": {
        "GOOGLE_SERVICE_INFO_PLIST": "@secret:GOOGLE_SERVICE_INFO_PLIST"
      }
    },
    "production": {
      "ios": {
        "simulator": false,
        "image": "latest"
      },
      "env": {
        "GOOGLE_SERVICE_INFO_PLIST": "@secret:GOOGLE_SERVICE_INFO_PLIST"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
